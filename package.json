{
  "name": "frontend",
  "private": true,
  "version": "1.5.0",
  "description": "Sistema PDV La Casa - Pedidos e Despacho",
  "author": "La Casa de Pastel <contato@lacasa.com>",
  "homepage": "https://github.com/lu080ul/LaCasaDePastel",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist:mac-arm64": "npm run build && electron-builder --mac --arm64",
    "dist:mac-x64": "npm run build && electron-builder --mac --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:publish": "npm run build && electron-builder --win --publish always",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl",
    "dist:publish": "npm run build && electron-builder -mwl --publish always"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "lu080ul",
      "repo": "LaCasaDePastel",
      "releaseType": "release"
    },
    "appId": "com.lacasa.pos",
    "productName": "La Casa PDV",
    "directories": {
      "output": "dist_installer"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "electron-updater": "^6.8.3",
    "firebase": "^12.12.0",
    "gsap": "^3.14.2",
    "lucide-react": "^1.7.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
